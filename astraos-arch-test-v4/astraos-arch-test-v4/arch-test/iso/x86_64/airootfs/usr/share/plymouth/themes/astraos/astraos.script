# AstraOS Plymouth theme - logo + barre de progression style Apple

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() * 0.35 - logo_image.GetHeight() / 2);

bar_width = 200;
bar_height = 4;
bar_x = Window.GetWidth() / 2 - bar_width / 2;
bar_y = Window.GetHeight() * 0.55;

bar_bg_image = Image.New(bar_width, bar_height);
bar_bg_image.Fill(0.15, 0.15, 0.15, 1.0);
bar_bg_sprite = Sprite(bar_bg_image);
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);

progress = 0.0;
progress_bar_sprite = Sprite();
progress_bar_sprite.SetX(bar_x);
progress_bar_sprite.SetY(bar_y);

fun on_tick(delta) {
    if (progress < 1.0) {
        progress += delta * 0.05;
        if (progress > 1.0) progress = 1.0;
        new_width = (bar_width * progress) + 1;
        new_bar = Image.New(new_width, bar_height);
        new_bar.Fill(1.0, 1.0, 1.0, 1.0);
        progress_bar_sprite.SetImage(new_bar);
    }
}

Plymouth.SetRefreshFunctionInHz(60);
